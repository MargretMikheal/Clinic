<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">{{ 'rolepermission.AddNewRole' | i18n }}</h3>
    </div>
    <div class="panel-body">
        <form name="addRoleForm" novalidate ng-submit="addRole()">
            <md-input-container class="md-block">
                <label>{{ 'rolepermission.RoleName' | i18n }}</label>
                <input type="text" ng-model="newRoleName" required />
            </md-input-container>
            <md-button type="submit" class="md-raised md-primary" ng-if="permissionsObj.Add" ng-disabled="isSaving || addRoleForm.$invalid">
                {{ 'rolepermission.AddRole' | i18n }}
            </md-button>
        </form>

        <hr />
        <h4>{{ 'rolepermission.ExistingRoles' | i18n }}</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>{{ 'rolepermission.RoleName' | i18n }}</th>
                        <th>{{ 'rolepermission.NumberOfUsers' | i18n }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="role in roles track by role.RoleId">
                        <td>{{ role.RoleName }}</td>
                        <td>{{ role.UserCount }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
