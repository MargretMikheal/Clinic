@{
    ViewBag.Title = "Users & Doctors Management";
}

<div ng-cloak>
    <md-tabs md-dynamic-height md-border-bottom md-selected="selectedTabIndex">
        <md-tab label="{{ 'users.UsersTab' | i18n }}">
            <md-content class="md-padding" ng-controller="UsersController">
                @Html.Partial("_UsersList")
            </md-content>
        </md-tab>
        <md-tab label="{{ 'users.DoctorsTab' | i18n }}">
            <md-content class="md-padding" ng-controller="DoctorsController">
                @Html.Partial("_DoctorsList")
            </md-content>
        </md-tab>
    </md-tabs>
</div>

@section Scripts {
    <script src="~/Areas/Administration/Scripts/Controllers/UsersController.js"></script>
    <script src="~/Areas/Administration/Scripts/Controllers/DoctorsController.js"></script>
}