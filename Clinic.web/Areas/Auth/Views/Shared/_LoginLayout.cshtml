@{
    var languageCookie = Request.Cookies["clinic_lang"];

    var currentLang = languageCookie != null
        ? languageCookie.Value
        : "ar";

    if (currentLang != "ar" && currentLang != "en")
    {
        currentLang = "ar";
    }

    var currentDir = currentLang == "ar" ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html ng-app="clinicApp"
      lang="@currentLang"
      dir="@currentDir">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        @ViewBag.Title - Clinic Management System
    </title>

    @Styles.Render("~/Content/css")
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />

    <link href="~/Content/clinic-theme.css"
          rel="stylesheet" />

    @if (currentLang == "ar")
    {
        <link href="~/Content/rtl.css"
              rel="stylesheet" />
    }

    @Scripts.Render("~/bundles/modernizr")

</head>

<body class="auth-page">

    @RenderBody()


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")


    <!-- AngularJS -->

    <script src="~/Scripts/angular.js"></script>

    <script src="~/Scripts/angular-cookies.js"></script>

    <script src="~/Scripts/angular-sanitize.js"></script>

    <script src="~/Scripts/angular-localization.js"></script>


    <!-- Clinic Angular Application -->

    <script src="~/Scripts/app/app.js"></script>

    <script src="~/Scripts/app/controllers/LanguageController.js"></script>

    <script src="~/Areas/Auth/Scripts/Services/authService.js"></script>

    <script src="~/Areas/Auth/Scripts/Controllers/AccountController.js"></script>

</body>

</html>