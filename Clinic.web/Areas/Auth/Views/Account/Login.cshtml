@{
    Layout = "~/Areas/Auth/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Login";
}

<div ng-controller="LoginController">

    <div class="clinic-login-card">

        <!-- Language -->
        <div class="clinic-login-language"
             ng-controller="LanguageController">

            <button type="button"
                    class="clinic-language-option"
                    ng-click="changeLanguage('en')">
                EN
            </button>

            <span class="clinic-language-separator">|</span>

            <button type="button"
                    class="clinic-language-option"
                    ng-click="changeLanguage('ar')">
                العربية
            </button>

        </div>


        <!-- Brand -->
        <div class="clinic-login-brand">

            <div class="clinic-logo clinic-logo-lg">
                <img src="~/Content/Images/clinic-logo.png"
                     alt="Clinic Management System" />
            </div>

            <h1 class="clinic-login-title">
                {{ 'common.Login' | i18n }}
            </h1>

        </div>


        <form ng-submit="login()"
              name="loginForm"
              novalidate>

            <!-- Username -->
            <div class="clinic-login-field">

                <label>
                    {{ 'common.Username' | i18n }}
                </label>

                <input type="text"
                       name="username"
                       class="clinic-login-input"
                       ng-model="credentials.username"
                       placeholder="{{ 'common.Username' | i18n }}"
                       required
                       autofocus />

                <span class="clinic-login-validation"
                      ng-show="loginForm.username.$invalid &&
                               loginForm.username.$touched">

                    {{ 'common.Required' | i18n }}

                </span>

            </div>


            <!-- Password -->
            <div class="clinic-login-field">

                <label>
                    {{ 'common.Password' | i18n }}
                </label>

                <div class="clinic-password-container">

                    <input type="{{ showPassword ? 'text' : 'password' }}"
                           name="password"
                           class="clinic-login-input clinic-password-input"
                           ng-model="credentials.password"
                           placeholder="{{ 'common.Password' | i18n }}"
                           required />

                    <button type="button"
                            class="clinic-password-button"
                            ng-click="togglePassword()"
                            tabindex="-1">

                        <svg ng-if="!showPassword"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>

                            <circle cx="12"
                                    cy="12"
                                    r="2.5">
                            </circle>

                        </svg>

                        <svg ng-if="showPassword"
                             viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M3 3l18 18"></path>

                            <path d="M10.6 6.2C11.05 6.07 11.52 6 12 6c6.5 0 10 6 10 6a18.8 18.8 0 0 1-3.2 3.4"></path>

                            <path d="M6.2 8.1C3.6 9.9 2 12 2 12s3.5 6 10 6c1.6 0 3-.35 4.2-.9"></path>

                        </svg>

                    </button>

                </div>

                <span class="clinic-login-validation"
                      ng-show="loginForm.password.$invalid &&
                               loginForm.password.$touched">

                    {{ 'common.Required' | i18n }}

                </span>

            </div>


            <!-- Error -->
            <div class="clinic-login-error"
                 ng-show="errorMessage">

                {{ errorMessage }}

            </div>


            <!-- Login -->
            <button type="submit"
                    class="clinic-login-button"
                    ng-disabled="loginForm.$invalid || isLoading">

                <span ng-show="!isLoading">
                    {{ 'common.Login' | i18n }}
                </span>

                <span ng-show="isLoading">
                    <span class="clinic-spinner"></span>
                    {{ 'common.SigningIn' | i18n }}
                </span>

            </button>

        </form>

    </div>

</div>