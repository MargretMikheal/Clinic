@{
    Layout = "~/Areas/Auth/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Login";
}

<div ng-controller="LoginController">

    <div class="auth-card">

        <!-- Language -->
        <div class="text-right" style="margin-bottom: 24px;"
             ng-controller="LanguageController">

            <span class="lang-switcher" style="justify-content: flex-end;">
                <a href="#"
                   class="lang-link"
                   ng-click="changeLanguage('en')">EN</a>
                <span class="lang-sep">|</span>
                <a href="#"
                   class="lang-link"
                   ng-click="changeLanguage('ar')">العربية</a>
            </span>

        </div>

        <!-- Brand -->
        <div class="auth-header">
            <img src="~/Content/Images/clinic-logo.png"
                 alt="Clinic Management System"
                 class="auth-logo" />
            
            <h1 class="auth-title">
                {{ 'common.Login' | i18n }}
            </h1>
        </div>

        <form ng-submit="login()"
              name="loginForm"
              novalidate>

            <!-- Username -->
            <div class="form-group">
                <label class="form-label">
                    {{ 'common.Username' | i18n }}
                </label>

                <input type="text"
                       name="username"
                       class="form-control"
                       ng-model="credentials.username"
                       placeholder="{{ 'common.Username' | i18n }}"
                       required
                       autofocus />

                <span class="form-error"
                      ng-show="loginForm.username.$invalid &&
                               loginForm.username.$touched">
                    {{ 'common.Required' | i18n }}
                </span>
            </div>

            <!-- Password -->
            <div class="form-group">
                <label class="form-label">
                    {{ 'common.Password' | i18n }}
                </label>

                <div style="position: relative;">
                    <input type="{{ showPassword ? 'text' : 'password' }}"
                           name="password"
                           class="form-control"
                           style="padding-right: 40px;"
                           ng-model="credentials.password"
                           placeholder="{{ 'common.Password' | i18n }}"
                           required />

                    <button type="button"
                            ng-click="togglePassword()"
                            tabindex="-1"
                            style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--c-text-muted);">
                        <i class="fa" ng-class="showPassword ? 'fa-eye-slash' : 'fa-eye'"></i>
                    </button>
                </div>

                <span class="form-error"
                      ng-show="loginForm.password.$invalid &&
                               loginForm.password.$touched">
                    {{ 'common.Required' | i18n }}
                </span>
            </div>

            <!-- Error -->
            <div class="c-alert c-alert-danger"
                 ng-show="errorMessage">
                 <i class="fa fa-exclamation-circle"></i>
                 <span>{{ errorMessage }}</span>
            </div>

            <!-- Login -->
            <button type="submit"
                    class="btn btn-primary"
                    style="width: 100%; height: 44px; margin-top: 16px; font-size: 16px;"
                    ng-disabled="loginForm.$invalid || isLoading">

                <span ng-show="!isLoading">
                    {{ 'common.Login' | i18n }}
                </span>

                <span ng-show="isLoading" style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <span class="c-spinner" style="width: 20px; height: 20px; border-width: 2px;"></span>
                    {{ 'common.SigningIn' | i18n }}
                </span>

            </button>

        </form>

    </div>

</div>