<?xml version="1.0" encoding="utf-8"?>
<Report Width="19cm" Name="DoctorAppointmentsReport" xmlns="http://schemas.telerik.com/reporting/2012/3.9">
  <DataSources>
    <SqlDataSource ConnectionString="ClinicConnection" SelectCommand="dbo.usp_DoctorAppointmentsReport_GetData" SelectCommandType="StoredProcedure" Name="DoctorAppointmentsDataSource">
      <Parameters>
        <SqlDataSourceParameter DbType="Int32" Name="@DoctorId">
          <Value>
            <String>= CInt(IsNull(Parameters.DoctorId.Value, 0))</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Date" Name="@FromDate">
          <Value>
            <String>= IIf(IsNull(Parameters.FromDate.Value, '') = '', Null, Parameters.FromDate.Value)</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Date" Name="@ToDate">
          <Value>
            <String>= IIf(IsNull(Parameters.ToDate.Value, '') = '', Null, Parameters.ToDate.Value)</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@Status">
          <Value>
            <String>= IIf(IsNull(Parameters.Status.Value, '') = '', Null, Parameters.Status.Value)</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
  <Items>
    <ReportHeaderSection Height="3.2cm" Name="reportHeaderSection1">
      <Items>
        <!-- Title -->
        <TextBox Width="13cm" Height="0.8cm" Left="0cm" Top="0.2cm" Value="DOCTOR APPOINTMENTS REPORT" Name="txtTitle">
          <Style VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="15pt" Bold="True" />
            <Color>30, 41, 59</Color>
          </Style>
        </TextBox>
        <!-- Clinic Badge -->
        <TextBox Width="6cm" Height="0.8cm" Left="13cm" Top="0.2cm" Value="CLINIC MANAGEMENT" Name="txtClinicBadge">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="10pt" Bold="True" />
            <Color>15, 118, 110</Color>
          </Style>
        </TextBox>
        <!-- Divider Line -->
        <Shape Width="19cm" Height="0.05cm" Left="0cm" Top="1.1cm" Name="shapeDivider">
          <ShapeType>
            <LineShape />
          </ShapeType>
          <Style Color="15, 118, 110">
            <LineWidth>1.5pt</LineWidth>
          </Style>
        </Shape>
        <!-- Filter Summary Box -->
        <Panel Width="19cm" Height="1.6cm" Left="0cm" Top="1.3cm" Name="panelFilters">
          <Style BackgroundColor="248, 250, 252">
            <BorderStyle Default="Solid" />
            <BorderColor Default="226, 232, 240" />
            <BorderWidth Default="1px" />
          </Style>
          <Items>
            <TextBox Width="9cm" Height="0.55cm" Left="0.4cm" Top="0.2cm" Value="= 'Doctor: ' + (IsNull(Parameters.DoctorId.Value, 0) = 0 ? 'All Doctors' : 'Doctor ID ' + Parameters.DoctorId.Value)" Name="lblDoctorFilter">
              <Style VerticalAlign="Middle">
                <Font Name="Segoe UI" Size="9pt" Bold="True" />
                <Color>51, 65, 85</Color>
              </Style>
            </TextBox>
            <TextBox Width="9cm" Height="0.55cm" Left="9.8cm" Top="0.2cm" Value="= 'Status: ' + (IsNull(Parameters.Status.Value, '') = '' ? 'All Statuses' : Parameters.Status.Value)" Name="lblStatusFilter">
              <Style VerticalAlign="Middle">
                <Font Name="Segoe UI" Size="9pt" Bold="True" />
                <Color>51, 65, 85</Color>
              </Style>
            </TextBox>
            <TextBox Width="9cm" Height="0.55cm" Left="0.4cm" Top="0.85cm" Value="= 'From Date: ' + (IsNull(Parameters.FromDate.Value, '') = '' ? 'Any' : Parameters.FromDate.Value)" Name="lblFromDateFilter">
              <Style VerticalAlign="Middle">
                <Font Name="Segoe UI" Size="8.5pt" />
                <Color>100, 116, 139</Color>
              </Style>
            </TextBox>
            <TextBox Width="9cm" Height="0.55cm" Left="9.8cm" Top="0.85cm" Value="= 'To Date: ' + (IsNull(Parameters.ToDate.Value, '') = '' ? 'Any' : Parameters.ToDate.Value)" Name="lblToDateFilter">
              <Style VerticalAlign="Middle">
                <Font Name="Segoe UI" Size="8.5pt" />
                <Color>100, 116, 139</Color>
              </Style>
            </TextBox>
          </Items>
        </Panel>
      </Items>
    </ReportHeaderSection>
    <DetailSection Height="1.6cm" Name="detailSection1">
      <Items>
        <Table DataSourceName="DoctorAppointmentsDataSource" Width="19cm" Height="1.4cm" Left="0cm" Top="0.1cm" ColumnHeadersPrintOnEveryPage="True" Name="tblAppointments">
          <Body>
            <Cells>
              <!-- Row # -->
              <TableCell RowIndex="0" ColumnIndex="0" RowSpan="1" ColumnSpan="1">
                <ReportItem>
                  <TextBox Width="1cm" Height="0.7cm" Left="0cm" Top="0cm" Value="= RowNumber()" Name="tdNum">
                    <Style TextAlign="Center" VerticalAlign="Middle">
                      <Font Name="Segoe UI" Size="8.5pt" />
                      <Color>100, 116, 139</Color>
                      <BorderStyle Bottom="Solid" />
                      <BorderColor Bottom="226, 232, 240" />
                      <BorderWidth Bottom="1px" />
                    </Style>
                  </TextBox>
                </ReportItem>
              </TableCell>
              <!-- Appointment Date -->
              <TableCell RowIndex="0" ColumnIndex="1" RowSpan="1" ColumnSpan="1">
                <ReportItem>
                  <TextBox Width="3.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="= Format('{0:yyyy-MM-dd}', Fields.AppointmentDate)" Name="tdDate">
                    <Style TextAlign="Left" VerticalAlign="Middle">
                      <Font Name="Segoe UI" Size="9pt" Bold="True" />
                      <Color>15, 23, 42</Color>
                      <BorderStyle Bottom="Solid" />
                      <BorderColor Bottom="226, 232, 240" />
                      <BorderWidth Bottom="1px" />
                      <Padding Left="4pt" Right="4pt" />
                    </Style>
                  </TextBox>
                </ReportItem>
              </TableCell>
              <!-- Appointment Time -->
              <TableCell RowIndex="0" ColumnIndex="2" RowSpan="1" ColumnSpan="1">
                <ReportItem>
                  <TextBox Width="2.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="= Format('{0:hh\:mm}', Fields.AppointmentTime)" Name="tdTime">
                    <Style TextAlign="Left" VerticalAlign="Middle">
                      <Font Name="Segoe UI" Size="9pt" />
                      <Color>30, 41, 59</Color>
                      <BorderStyle Bottom="Solid" />
                      <BorderColor Bottom="226, 232, 240" />
                      <BorderWidth Bottom="1px" />
                      <Padding Left="4pt" Right="4pt" />
                    </Style>
                  </TextBox>
                </ReportItem>
              </TableCell>
              <!-- Patient -->
              <TableCell RowIndex="0" ColumnIndex="3" RowSpan="1" ColumnSpan="1">
                <ReportItem>
                  <TextBox Width="4.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="= Fields.PatientName" Name="tdPatient">
                    <Style TextAlign="Left" VerticalAlign="Middle">
                      <Font Name="Segoe UI" Size="9pt" />
                      <Color>15, 23, 42</Color>
                      <BorderStyle Bottom="Solid" />
                      <BorderColor Bottom="226, 232, 240" />
                      <BorderWidth Bottom="1px" />
                      <Padding Left="4pt" Right="4pt" />
                    </Style>
                  </TextBox>
                </ReportItem>
              </TableCell>
              <!-- Doctor -->
              <TableCell RowIndex="0" ColumnIndex="4" RowSpan="1" ColumnSpan="1">
                <ReportItem>
                  <TextBox Width="4.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="= 'Dr. ' + Fields.DoctorName" Name="tdDoctor">
                    <Style TextAlign="Left" VerticalAlign="Middle">
                      <Font Name="Segoe UI" Size="9pt" />
                      <Color>15, 23, 42</Color>
                      <BorderStyle Bottom="Solid" />
                      <BorderColor Bottom="226, 232, 240" />
                      <BorderWidth Bottom="1px" />
                      <Padding Left="4pt" Right="4pt" />
                    </Style>
                  </TextBox>
                </ReportItem>
              </TableCell>
              <!-- Status -->
              <TableCell RowIndex="0" ColumnIndex="5" RowSpan="1" ColumnSpan="1">
                <ReportItem>
                  <TextBox Width="3cm" Height="0.7cm" Left="0cm" Top="0cm" Value="= Fields.Status" Name="tdStatus">
                    <Style TextAlign="Center" VerticalAlign="Middle">
                      <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                      <Color>15, 118, 110</Color>
                      <BorderStyle Bottom="Solid" />
                      <BorderColor Bottom="226, 232, 240" />
                      <BorderWidth Bottom="1px" />
                      <Padding Left="4pt" Right="4pt" />
                    </Style>
                  </TextBox>
                </ReportItem>
              </TableCell>
            </Cells>
            <Columns>
              <Column Width="1cm" />
              <Column Width="3.5cm" />
              <Column Width="2.5cm" />
              <Column Width="4.5cm" />
              <Column Width="4.5cm" />
              <Column Width="3cm" />
            </Columns>
            <Rows>
              <Row Height="0.7cm" />
            </Rows>
          </Body>
          <Corner />
          <RowGroups>
            <TableGroup Name="detailTableGroup">
              <Groupings>
                <Grouping />
              </Groupings>
            </TableGroup>
          </RowGroups>
          <ColumnGroups>
            <!-- Header Column # -->
            <TableGroup Name="colNum">
              <ReportItem>
                <TextBox Width="1cm" Height="0.7cm" Left="0cm" Top="0cm" Value="#" Name="thNum">
                  <Style BackgroundColor="15, 118, 110" TextAlign="Center" VerticalAlign="Middle">
                    <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                    <Color>255, 255, 255</Color>
                  </Style>
                </TextBox>
              </ReportItem>
            </TableGroup>
            <!-- Header Column Date -->
            <TableGroup Name="colDate">
              <ReportItem>
                <TextBox Width="3.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="Appointment Date" Name="thDate">
                  <Style BackgroundColor="15, 118, 110" TextAlign="Left" VerticalAlign="Middle">
                    <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                    <Color>255, 255, 255</Color>
                    <Padding Left="4pt" Right="4pt" />
                  </Style>
                </TextBox>
              </ReportItem>
            </TableGroup>
            <!-- Header Column Time -->
            <TableGroup Name="colTime">
              <ReportItem>
                <TextBox Width="2.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="Time" Name="thTime">
                  <Style BackgroundColor="15, 118, 110" TextAlign="Left" VerticalAlign="Middle">
                    <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                    <Color>255, 255, 255</Color>
                    <Padding Left="4pt" Right="4pt" />
                  </Style>
                </TextBox>
              </ReportItem>
            </TableGroup>
            <!-- Header Column Patient -->
            <TableGroup Name="colPatient">
              <ReportItem>
                <TextBox Width="4.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="Patient" Name="thPatient">
                  <Style BackgroundColor="15, 118, 110" TextAlign="Left" VerticalAlign="Middle">
                    <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                    <Color>255, 255, 255</Color>
                    <Padding Left="4pt" Right="4pt" />
                  </Style>
                </TextBox>
              </ReportItem>
            </TableGroup>
            <!-- Header Column Doctor -->
            <TableGroup Name="colDoctor">
              <ReportItem>
                <TextBox Width="4.5cm" Height="0.7cm" Left="0cm" Top="0cm" Value="Doctor" Name="thDoctor">
                  <Style BackgroundColor="15, 118, 110" TextAlign="Left" VerticalAlign="Middle">
                    <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                    <Color>255, 255, 255</Color>
                    <Padding Left="4pt" Right="4pt" />
                  </Style>
                </TextBox>
              </ReportItem>
            </TableGroup>
            <!-- Header Column Status -->
            <TableGroup Name="colStatus">
              <ReportItem>
                <TextBox Width="3cm" Height="0.7cm" Left="0cm" Top="0cm" Value="Status" Name="thStatus">
                  <Style BackgroundColor="15, 118, 110" TextAlign="Center" VerticalAlign="Middle">
                    <Font Name="Segoe UI" Size="8.5pt" Bold="True" />
                    <Color>255, 255, 255</Color>
                    <Padding Left="4pt" Right="4pt" />
                  </Style>
                </TextBox>
              </ReportItem>
            </TableGroup>
          </ColumnGroups>
        </Table>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.7cm" Name="pageFooterSection1">
      <Items>
        <TextBox Width="10cm" Height="0.6cm" Left="0cm" Top="0.05cm" Value="= 'Printed on: ' + Format('{0:yyyy-MM-dd HH:mm}', Now())" Name="txtPrintTime">
          <Style VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="8pt" />
            <Color>148, 163, 184</Color>
          </Style>
        </TextBox>
        <TextBox Width="6cm" Height="0.6cm" Left="13cm" Top="0.05cm" Value="= 'Page ' + PageNumber + ' of ' + PageCount" Name="txtPageNumbers">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="8pt" />
            <Color>148, 163, 184</Color>
          </Style>
        </TextBox>
      </Items>
    </PageFooterSection>
  </Items>
  <PageSettings>
    <PageSettings PaperKind="A4" Landscape="False">
      <Margins>
        <MarginsU Left="1cm" Right="1cm" Top="1cm" Bottom="1cm" />
      </Margins>
    </PageSettings>
  </PageSettings>
  <ReportParameters>
    <ReportParameter Name="DoctorId" Type="Integer">
      <Value>
        <String>0</String>
      </Value>
    </ReportParameter>
    <ReportParameter Name="FromDate" Type="String" AllowNull="True" />
    <ReportParameter Name="ToDate" Type="String" AllowNull="True" />
    <ReportParameter Name="Status" Type="String" AllowNull="True" />
  </ReportParameters>
</Report>
