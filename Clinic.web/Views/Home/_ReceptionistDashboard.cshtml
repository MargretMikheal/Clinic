<!-- Receptionist Dashboard -->

<div class="page-subtitle" style="margin-bottom: var(--space-4);" ng-show="dashboardData.DoctorName">
    <i class="fa fa-user-md"></i>
    {{ 'dashboard.Doctor' | i18n }}: {{ dashboardData.DoctorName }}
</div>

<!-- Quick Actions -->
<div class="row" style="margin-bottom: var(--space-6);">
    <div class="col-sm-6 col-md-3">
        <a href="/Patients/Create" class="c-card text-center" style="display: block; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s;">
            <div class="c-card-body">
                <i class="fa fa-user-plus" style="font-size: 28px; color: var(--c-primary); margin-bottom: var(--space-3);"></i>
                <div style="font-weight: 600; color: var(--c-text);">
                    {{ 'dashboard.NewPatient' | i18n }}
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-md-3">
        <a href="/Appointments/Create" class="c-card text-center" style="display: block; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s;">
            <div class="c-card-body">
                <i class="fa fa-calendar-plus-o" style="font-size: 28px; color: var(--c-primary); margin-bottom: var(--space-3);"></i>
                <div style="font-weight: 600; color: var(--c-text);">
                    {{ 'dashboard.NewAppointment' | i18n }}
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Statistics -->
<div class="stat-grid">

    <div ng-repeat="stat in dashboardData.Statistics track by stat.Key"
         class="stat-card"
         ng-class="{'active': selectedStatistic.Key === stat.Key}"
         ng-click="selectStatistic(stat)">

        <div class="stat-icon" ng-class="stat.ColorClass.replace('clinic-dashboard-stat-icon-', 'stat-')">
            <i class="fa" ng-class="stat.Icon"></i>
        </div>

        <div class="stat-content">
            <div class="stat-value">
                {{ stat.Count }}
            </div>
            <div class="stat-label" title="{{ stat.LocalizationKey | i18n }}">
                {{ stat.LocalizationKey | i18n }}
            </div>
        </div>

    </div>

</div>
