<div class="stat-grid">

    <div ng-repeat="stat in dashboardData.Statistics track by stat.Key"
         class="stat-card"
         ng-class="{'active': selectedStatistic.Key === stat.Key}"
         ng-click="selectStatistic(stat)">

        <div class="stat-icon" ng-class="stat.ColorClass.replace('clinic-dashboard-stat-icon-', 'stat-')">
            <i class="fa" ng-class="stat.Icon"></i>
        </div>

        <div class="stat-content">
            <div class="stat-value">
                {{ stat.Count }}
            </div>
            <div class="stat-label" title="{{ stat.LocalizationKey | i18n }}">
                {{ stat.LocalizationKey | i18n }}
            </div>
        </div>

    </div>

</div>

<div class="c-card" style="margin-top: var(--space-6);" ng-if="dashboardData.MostBookedDoctors && dashboardData.MostBookedDoctors.length > 0">
    <div class="c-card-header">
        <h3 class="c-card-title">
            <i class="fa fa-user-md"></i>
            {{ 'dashboard.MostBookedDoctors' | i18n }}
        </h3>
    </div>
    <div class="c-card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="c-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ 'dashboard.DoctorName' | i18n }}</th>
                        <th>{{ 'dashboard.DoctorCode' | i18n }}</th>
                        <th>{{ 'dashboard.AppointmentCount' | i18n }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="doc in dashboardData.MostBookedDoctors track by doc.DoctorId">
                        <td>{{ $index + 1 }}</td>
                        <td>{{ doc.DoctorName }}</td>
                        <td>{{ doc.DoctorCode }}</td>
                        <td>{{ doc.AppointmentCount }} {{ 'dashboard.appointments' | i18n }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>