@{
    ViewBag.Title = "Dashboard";
}

<div class="row" ng-controller="DashboardController">
    <div class="col-md-12">
        <h1 class="page-header">{{ 'common.Dashboard' | i18n }}</h1>
    </div>

    <div class="col-md-12" ng-show="isLoading">
        <p><i class="fa fa-spinner fa-spin"></i> {{ 'common.Loading' | i18n }}</p>
    </div>

    <div class="col-md-12" ng-show="!isLoading && errorMessage">
        <div class="alert alert-danger">{{ errorMessage }}</div>
    </div>

    <div class="col-md-12" ng-show="!isLoading && !errorMessage">
        <div class="jumbotron text-center">
            <h2>{{ 'common.Welcome' | i18n }}, {{ userInfo.DisplayName }}!</h2>
            <p>
                <strong>{{ 'common.Role' | i18n }}:</strong> 
                <span ng-repeat="role in userInfo.Roles" class="label label-primary" style="margin-right: 5px;">{{ role }}</span>
            </p>
        </div>
    </div>
</div>