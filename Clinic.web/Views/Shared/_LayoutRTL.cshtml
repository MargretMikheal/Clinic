@{
    var currentLang = "ar";
}

<!DOCTYPE html>
<html ng-app="clinicApp" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        @ViewBag.Title - Clinic Management System
    </title>

    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/toastr")
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/angular-material.min.css" rel="stylesheet" />
    <link href="~/Content/clinic-theme.css" rel="stylesheet" />
    <link href="~/Content/rtl.css" rel="stylesheet" />
    <link href="~/Scripts/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>
    <!-- Top Navbar -->
    <header class="app-navbar">

        <!-- Logo and Toggle - Right/Left handled by flex row-reverse in RTL -->
        <div style="display: flex; align-items: center; height: 100%;">
            <button type="button" id="sidebarToggle" class="sidebar-toggle">
                <i class="fa fa-bars"></i>
            </button>
            <a href="@Url.Action("Index", "Home", new { area = "" })"
               class="nav-brand">

                <img src="~/Content/Images/clinic-logo.png"
                     alt="Clinic Management System"
                     class="nav-brand-logo" />

                <span class="nav-brand-text">
                    Clinic Management
                </span>

            </a>
        </div>

        <!-- Actions -->
        <div class="nav-actions">

            <span class="lang-switcher"
                  ng-controller="LanguageController">

                <a href="#"
                   class="lang-link"
                   ng-click="changeLanguage('en')">
                    English
                </a>

                <span class="lang-sep">|</span>

                <a href="#"
                   class="lang-link active"
                   ng-click="changeLanguage('ar')">
                    العربية
                </a>

            </span>

            @if (Request.IsAuthenticated)
            {
                <button type="button"
                        class="btn btn-danger"
                        ng-controller="LogoutController"
                        ng-click="logout()">

                    <i class="fa fa-sign-out"></i>
                    {{ 'common.Logout' | i18n }}

                </button>
            }

        </div>

    </header>

    <!-- Page Layout -->
    <div class="app-layout">

        <!-- Sidebar -->
        <aside class="app-sidebar">
            @Html.Partial("_Menu")
        </aside>

        <!-- Content -->
        <main class="app-main">
            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>


    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/toastr")

    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/angular-animate.min.js"></script>
    <script src="~/Scripts/angular-aria.min.js"></script>
    <script src="~/Scripts/angular-material.min.js"></script>
    <script src="~/Scripts/angular-cookies.js"></script>
    <script src="~/Scripts/angular-sanitize.js"></script>
    <script src="~/Scripts/angular-localization.js"></script>

    <script src="~/Scripts/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/Scripts/app/app.js"></script>
    <script src="~/Scripts/app/services/permissionService.js"></script>
    <script src="~/Scripts/app/services/appointmentStatusService.js"></script>
    <script src="~/Scripts/app/directives/clinicPagination.js"></script>
    <script src="~/Scripts/app/controllers/LanguageController.js"></script>
    <script src="~/Scripts/app/clinic-menu.js"></script>
    <script src="~/Areas/Auth/Scripts/Services/authService.js"></script>
    <script src="~/Scripts/app/services/dashboardService.js"></script>
    <script src="~/Scripts/app/controllers/DashboardController.js"></script>
    <script src="~/Areas/Auth/Scripts/Controllers/AccountController.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
