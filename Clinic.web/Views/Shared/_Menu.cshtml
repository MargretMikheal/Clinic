@using System.Web
@using System.Web.Mvc
@using MvcSiteMapProvider.Web.Html
@using MvcSiteMapProvider

<ul class="side-menu">

    <!-- Home -->
    <li class="side-menu-item">
        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="side-menu-link">

            <i class="fa fa-home"></i>

            <span>
                {{ 'common.Home' | i18n }}
            </span>

        </a>
    </li>


    @if (Html.MvcSiteMap().SiteMap != null &&
         Html.MvcSiteMap().SiteMap.RootNode != null)
    {
        foreach (var parentNode in Html.MvcSiteMap().SiteMap.RootNode.ChildNodes)
        {
            if(!parentNode.IsVisible(new Dictionary<string, object>()))
{
                continue;
            }

            var parentIcon =
        parentNode.Attributes.ContainsKey("icon")
            ? parentNode.Attributes["icon"].ToString()
            : "fa-folder";


            /*
             * Main item WITH children
             */
            if (parentNode.HasChildNodes)
            {
                <li class="side-menu-item">

                    <a href="#"
                       class="side-menu-link">

                        <i class="fa @parentIcon"></i>

                        <span>
                            {{ '@parentNode.Title' | i18n }}
                        </span>

                    </a>

                    <!-- Submenu items currently flattened or handle with nested classes if needed -->
                    @foreach (var childNode in parentNode.ChildNodes)
                    {
                        if (!childNode.IsVisible(new Dictionary<string, object>()))
                        {
                            continue;
                        }

                        var childIcon =
                            childNode.Attributes.ContainsKey("icon")
                                ? childNode.Attributes["icon"].ToString()
                                : "fa-circle-o";

                        string url = childNode.Url ?? "#";

                        <li class="side-menu-item" style="padding-right: 20px;">

                            <a href="@url"
                               class="side-menu-link">

                                <i class="fa @childIcon"></i>

                                <span>
                                    {{ '@childNode.Title' | i18n }}
                                </span>

                            </a>

                        </li>
                    }

                </li>
            }
            else
            {

                string url = parentNode.Url ?? "#";

                <li class="side-menu-item">

                    <a href="@url"
                       class="side-menu-link">

                        <i class="fa @parentIcon"></i>

                        <span>
                            {{ '@parentNode.Title' | i18n }}
                        </span>

                    </a>

                </li>
            }
        }
    }

</ul>