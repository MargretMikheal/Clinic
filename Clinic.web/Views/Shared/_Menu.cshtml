@using System.Web
@using System.Web.Mvc
@using MvcSiteMapProvider.Web.Html
@using MvcSiteMapProvider

<ul class="nav navbar-nav sidebar-menu">
    <li>
        <a href="@Url.Action("Index", "Home", new { area = "" })">
            <i class="fa fa-home"></i>
            <span>{{ 'common.Home' | i18n }}</span>
        </a>
    </li>
    @if (Html.MvcSiteMap().SiteMap != null && Html.MvcSiteMap().SiteMap.RootNode != null)
    {
        foreach (var parentNode in Html.MvcSiteMap().SiteMap.RootNode.ChildNodes)
        {
            if (parentNode.IsAccessibleToUser())
            {
                var parentIcon = parentNode.Attributes.ContainsKey("icon") ? parentNode.Attributes["icon"].ToString() : "";
                
                <li class="treeview">
                    <a href="#">
                        @if (!string.IsNullOrEmpty(parentIcon))
                        {
                            <i class="fa @parentIcon"></i>
                        }
                        <span>{{ '@parentNode.Title' | i18n }}</span>
                        <span class="pull-right-container">
                            <i class="fa fa-angle-left pull-right"></i>
                        </span>
                    </a>
                    
                    @if (parentNode.HasChildNodes)
                    {
                        <ul class="treeview-menu">
                            @foreach (var childNode in parentNode.ChildNodes)
                            {
                                if (childNode.IsAccessibleToUser())
                                {
                                    var childIcon = childNode.Attributes.ContainsKey("icon") ? childNode.Attributes["icon"].ToString() : "";
                                    string url = childNode.Url ?? "#";
                                    <li>
                                        <a href="@url">
                                            @if (!string.IsNullOrEmpty(childIcon))
                                            {
                                                <i class="fa @childIcon"></i>
                                            }
                                            {{ '@childNode.Title' | i18n }}
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </li>
            }
        }
    }
</ul>
