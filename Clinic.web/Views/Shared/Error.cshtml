@model System.Web.Mvc.HandleErrorInfo
@{
    Layout = Request.IsAuthenticated ? "~/Views/Shared/_Layout.cshtml" : "~/Areas/Auth/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Error";
}

<div class="row">
    <div class="col-md-12 text-center" style="margin-top: 50px;">
        <h2 class="text-danger"><i class="fa fa-exclamation-triangle"></i> {{ 'common.Error' | i18n }}</h2>
        
        @if (ViewData["ErrorMessage"] != null)
        {
            <p class="lead">@ViewData["ErrorMessage"]</p>
        }
        else
        {
            <p class="lead">{{ 'common.SomethingWentWrong' | i18n }}</p>
        }

        @if (ViewData["ErrorId"] != null)
        {
            <p class="text-muted">Error ID: @ViewData["ErrorId"]</p>
        }

        <br />
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-primary">{{ 'common.ReturnHome' | i18n }}</a>
    </div>
</div>
