@{
    var currentLang = "en";
}

<!DOCTYPE html>
<html ng-app="clinicApp" lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        @ViewBag.Title - Clinic Management System
    </title>

    @Styles.Render("~/Content/css")

    <link href="~/Content/clinic-theme.css" rel="stylesheet" />

    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <!-- Top Navbar -->
    <header class="clinic-navbar">

        <div class="container-fluid">

            <div class="clinic-navbar-inner">

                <a href="@Url.Action("Index", "Home", new { area = "" })"
                   class="clinic-brand">

                    <div class="clinic-logo">
                        <img src="~/Content/Images/clinic-logo.png"
                             alt="Clinic Management System" />
                    </div>

                    <span class="clinic-brand-name">
                          Clinic Management 
                    </span>

                </a>

                <div class="clinic-navbar-actions">

                    @if (Request.IsAuthenticated)
                    {
                        <button type="button"
                                class="btn btn-sm btn-danger"
                                ng-controller="LogoutController"
                                ng-click="logout()">

                            <i class="fa fa-sign-out"></i>
                            {{ 'common.Logout' | i18n }}

                        </button>
                    }

                    <span class="clinic-language-switcher"
                          ng-controller="LanguageController">

                        <a href="#"
                           ng-click="changeLanguage('en')">
                            English
                        </a>

                        <span class="clinic-language-separator">|</span>

                        <a href="#"
                           ng-click="changeLanguage('ar')">
                            العربية
                        </a>

                    </span>

                </div>

            </div>

        </div>

    </header>


    <!-- Page -->
    <div class="clinic-page">

        <div class="clinic-layout">

            <!-- Sidebar -->
            <aside class="clinic-sidebar">
                @Html.Partial("_Menu")
            </aside>

            <!-- Content -->
            <main class="clinic-content">
                @RenderBody()
            </main>

        </div>

    </div>


    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/angular-cookies.js"></script>
    <script src="~/Scripts/angular-sanitize.js"></script>
    <script src="~/Scripts/angular-localization.js"></script>

    <script src="~/Scripts/app/app.js"></script>

    <script src="~/Scripts/app/controllers/LanguageController.js"></script>
    <script src="~/Scripts/app/clinic-menu.js"></script>

    <script src="~/Areas/Auth/Scripts/Services/authService.js"></script>

    <script src="~/Scripts/app/controllers/DashboardController.js"></script>

    <script src="~/Areas/Auth/Scripts/Controllers/AccountController.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>